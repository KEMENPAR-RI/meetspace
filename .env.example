# Public base URL for QR codes and copied links (http/https origin, no path). Empty = QR disabled (503).
APP_URL=http://127.0.0.1:3000

# MySQL Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_name
DB_USERNAME=root
DB_PASSWORD=root

# Maintainer name shown on error pages. Inlined at build time: changing it requires a rebuild. Empty = "BIRODATIN - APJAR".
NEXT_PUBLIC_APP_MAINTAINER="BIRODATIN - APJAR"
