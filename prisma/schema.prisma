generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// CHECK constraint and the booking_locks seed row live in the init migration SQL.
model Booking {
  id         String   @id @default(uuid()) @db.Char(36)
  startsAt   DateTime @map("starts_at") @db.DateTime(6)
  endsAt     DateTime @map("ends_at") @db.DateTime(6)
  bookerName String   @map("booker_name") @db.VarChar(100)
  // Column keeps its legacy name; labelled "Satker/Instansi" in the app.
  satker     String   @map("division") @db.VarChar(100)
  agenda     String   @db.VarChar(1000)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(6)
  roomId     String   @map("room_id") @db.Char(36)

  room Room @relation(fields: [roomId], references: [id], onDelete: Restrict)

  // Per-room schedule/overlap lookups; also backs the room_id FK.
  @@index([roomId, startsAt])
  @@index([startsAt])
  @@index([endsAt])
  @@map("bookings")
}

// Fixed-window hit counter for public booking submits (legacy table name); ip_key collation (ascii_bin) lives in the migration SQL.
model AttendanceRateLimit {
  ipKey       String   @map("ip_key") @db.VarChar(40)
  windowStart DateTime @map("window_start") @db.DateTime(0)
  hits        Int      @default(0) @db.UnsignedInt

  @@id([ipKey, windowStart])
  @@index([windowStart])
  @@map("attendance_rate_limits")
}

enum UserRole {
  SUPERADMIN
  ADMIN
}

// The capacity CHECK lives in the migration SQL.
model Room {
  id         String   @id @default(uuid()) @db.Char(36)
  // utf8mb4_unicode_ci makes this unique case-insensitively.
  name       String   @unique @db.VarChar(100)
  building   String?  @db.VarChar(100)
  floor      String?  @db.VarChar(20)
  capacity   Int?     @db.UnsignedSmallInt
  facilities String?  @db.VarChar(500)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  bookings Booking[]
  admins   RoomAdmin[]

  @@index([isActive, name])
  @@map("rooms")
}

// username (lowercased by the app) and password_hash use ascii_bin collation in the migration SQL.
model User {
  id           String   @id @default(uuid()) @db.Char(36)
  username     String   @unique @db.VarChar(50)
  name         String   @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  rooms    RoomAdmin[]
  sessions Session[]

  @@index([role, isActive])
  @@map("users")
}

// Room person-in-charge assignment (admin role only, enforced by the app); one room per admin, many admins per room.
model RoomAdmin {
  roomId    String   @map("room_id") @db.Char(36)
  userId    String   @unique @map("user_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@map("room_admins")
}

// Server-side login session; the cookie holds the raw token, only its SHA-256 hex is stored (ascii_bin in the migration SQL).
model Session {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.DateTime(6)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // Expired-session cleanup.
  @@index([expiresAt])
  @@map("sessions")
}

// Key-value app settings; values are strings ('true'/'false', decimal numbers), parsed by the app. key uses ascii_bin in the migration SQL.
model AppSetting {
  id    String @id @default(uuid()) @db.Char(36)
  key   String @unique @db.VarChar(64)
  // MEDIUMTEXT so a base64 logo (<= 512 KB raw) fits.
  value String @db.MediumText

  @@map("app_settings")
}

// Legacy single-row lock (ADR 0001), unused since ADR 0003; dropped in a later migration.
model BookingLock {
  id Int @id @db.TinyInt

  @@map("booking_locks")
}
